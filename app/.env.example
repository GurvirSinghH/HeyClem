# Copy to .env (git-ignored).

# Where the worker runs: `npm run dev` in ../worker, or your deployed *.workers.dev URL.
CLEM_WORKER_URL=http://127.0.0.1:8787

# Must equal CLEM_APP_TOKEN in worker/.dev.vars (or the deployed worker's secret).
CLEM_APP_TOKEN=change-me-to-a-long-random-string

# The model that answers. IDs starting with @cf/ run on Cloudflare Workers AI; the rest are Claude.
# The worker must allow it (WORKERS_AI_MODELS or ALLOWED_MODELS) and hold that provider's secrets.
#   Free daily allowance:  @cf/meta/llama-4-scout-17b-16e-instruct, @cf/mistralai/mistral-small-3.1-24b-instruct
#   Claude:                claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5
CLEM_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# Claude only. Thinking effort for spoken answers.
CLEM_EFFORT=low

# Deepgram language: en, or multi for mixed-language speech (e.g. English + Hindi).
CLEM_STT_LANGUAGE=en
